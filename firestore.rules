rules_version = '2';
// The site talks to Firestore straight from the browser, so these rules are the only gatekeeper.
// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function validTask(d) {
      return d.keys().hasOnly(['date', 'time', 'text', 'done', 'remind', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['date', 'time', 'text', 'done', 'remind', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && (d.time == '' || d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && d.text is string && d.text.size() > 0 && d.text.size() <= 140
        && d.done is bool && d.remind is bool
        && d.updatedAt is int;
    }

    // Shared notepad: one document, readable and editable by everyone
    match /shared/notepad {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000
        && request.resource.data.updatedAt is int;
    }

    // Shared pictures: compressed JPEG/PNG data URLs, anyone can add or remove
    match /pictures/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'data', 'w', 'h', 'by', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.by is string && request.resource.data.by.size() <= 20
        && request.resource.data.data is string && request.resource.data.data.size() <= 950000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.w is int && request.resource.data.h is int
        && request.resource.data.w > 0 && request.resource.data.w <= 2048 && request.resource.data.h > 0 && request.resource.data.h <= 2048
        && request.resource.data.createdAt is int;
      allow delete: if true;
    }

    // Shared leaderboards: scores/{game}/entries/{id}, add-only
    match /scores/{game}/entries/{id} {
      allow read: if true;
      allow create: if game in ['snake', 'breakout', 'pinball', 'solitaire', 'spider', 'mine-Beginner', 'mine-Intermediate', 'mine-Expert']
        && request.resource.data.keys().hasOnly(['name', 'score', 'level', 'time', 'mode', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.score is int && request.resource.data.score >= -10000 && request.resource.data.score <= 100000000
        && (!('level' in request.resource.data) || request.resource.data.level is int)
        && (!('time' in request.resource.data) || request.resource.data.time is int)
        && (!('mode' in request.resource.data) || (request.resource.data.mode is string && request.resource.data.mode.size() <= 20))
        && request.resource.data.createdAt is int;
    }

    // One-time-code attempt counters, written by api/contact (keyed by a hash of the code token).
    // Counters can only go up by one, a used code can never be un-used, and nothing can be deleted.
    match /otp/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['n', 'used', 'exp'])
        && request.resource.data.n == 1 && request.resource.data.used == false && request.resource.data.exp is int;
      allow update: if request.resource.data.keys().hasOnly(['n', 'used', 'exp']) && request.resource.data.exp == resource.data.exp
        && ((request.resource.data.n == resource.data.n + 1 && request.resource.data.used == resource.data.used)
          || (request.resource.data.n == resource.data.n && resource.data.used == false && request.resource.data.used == true));
    }

    // Shared calendar tasks
    match /tasks/{id} {
      allow read: if true;
      allow create, update: if validTask(request.resource.data);
      allow delete: if true;
    }

  }
}
